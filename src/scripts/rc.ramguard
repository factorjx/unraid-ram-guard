#!/bin/bash
# Start/stop wrapper for the RAM Guard daemon.

DAEMON="/usr/local/emhttp/plugins/ram.guard/scripts/ramguard"
PID_FILE="/var/run/ramguard.pid"

pid_of() {
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] && grep -qa 'scripts/ramguard' "/proc/$pid/cmdline" 2>/dev/null && echo "$pid"
}

start() {
  if pid_of >/dev/null; then
    echo "RAM Guard уже запущен"
    return 0
  fi
  # New session: the daemon and its children form one process group for stop()
  setsid "$DAEMON" run </dev/null >/dev/null 2>&1 &
  sleep 1
  if pid_of >/dev/null; then
    echo "RAM Guard запущен"
  else
    echo "RAM Guard не запущен (выключен в настройках?)"
  fi
}

stop() {
  local pid
  pid=$(pid_of) || { echo "RAM Guard не запущен"; return 0; }
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  for _ in {1..20}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL -- "-$pid" 2>/dev/null
  rm -f "$PID_FILE"
  echo "RAM Guard остановлен"
}

case $1 in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    if pid=$(pid_of); then echo "running $pid"; else echo "stopped"; exit 1; fi
    ;;
  *) echo "Использование: $0 {start|stop|restart|status}"; exit 1 ;;
esac
